{
  "name": "motif-server",
  "version": "0.1.0",
  "private": true,
  "description": "Motif Action server: session persistence, inspiration ledger, prototype history, and a debug UI.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  }
}
